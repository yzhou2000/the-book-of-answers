{
  "expo": {
    "name": "答案之书",
    "slug": "the-book-of-answers-zh",
    "scheme": "thebookofanswerszh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "jsEngine": "jsc",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yzhou2026.thebookofanswerszh",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yzhou2026.thebookofanswerszh"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads/app.plugin.js",
        {
          "androidAppId": "ca-app-pub-2776707850684969~2028483605",
          "iosAppId": "ca-app-pub-2776707850684969~3662781865"
        }
      ],
      [
       "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "29624fa7-6eb7-4e72-99f7-51aa502365ba"
      }
    },
    "owner": "yzhou2026"
  }
}
